# ============================================================
# Firebase Configuration for LivFabs Storefront
# ============================================================
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSy_YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=livfabs-storefront.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=livfabs-storefront
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=livfabs-storefront.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=1029384756
NEXT_PUBLIC_FIREBASE_APP_ID=1:1029384756:web:livfabs1234

# ============================================================
# Razorpay Payment Gateway Configuration
# Get your keys from: https://dashboard.razorpay.com/#/app/keys
# (Works with both Test mode rzp_test_... and Live mode rzp_live_...)
# ============================================================
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_ID=rzp_test_YOUR_KEY_ID_HERE
RAZORPAY_KEY_SECRET=YOUR_KEY_SECRET_HERE
